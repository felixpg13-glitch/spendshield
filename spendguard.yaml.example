# SpendGuard 策略文件(策略即代码)
# 用法: guard = SpendGuard(policy="spendguard.yaml")

# 干跑模式(默认开): 只预览不真花
dry_run: true

# 总预算(0 = 不限)
budget: 200

# 单次上限(0 = 不限)
max_amount: 500

# 收款方黑名单: 命中直接拒绝
blacklist:
  - 未知供应商
  - 测试收款
  - "0x"            # 加密货币地址开头

# 收款方白名单: 命中跳过人工确认
whitelist:
  - 麦当劳
  - 官方
  - example.com

# 频率限制: 同一收款方 window 秒内最多 max_calls 次
rate_limit:
  window_s: 60
  max_calls: 3

# 人工确认: None=不需要 / console=终端 / callable
approval: console

# 意图一致性(防提示注入): 敏感操作强制审批
approve_new_recipient: true   # 新收款方首次交易强制确认(需配置 approval, 否则默认拒绝)
approve_above: 0              # 超过该金额强制确认(0 = 不限)

# 🔑 Agent 身份层(KYA 最小实现): 每个 agent 独立策略, 未注册默认拒绝
allow_unknown: false
agents:
  mcd_bot:               # 麦当当自动下单 agent
    budget: 50
    max_amount: 30
    blacklist: [测试收款, 未知供应商]
    whitelist: [麦当劳]
    rate_limit: {window_s: 60, max_calls: 3}
  airguard_repair:       # AirGuard AI 修复 agent
    budget: 10
    approval: tg
